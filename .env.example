# Copy to .env and fill in. Provider switching is .env-only -- no code changes.

# ---- Groq (default LLM + STT + Orpheus TTS credentials) ----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_S=30

# ---- LLM provider selection: groq | vllm | llamacpp ----
LLM_PROVIDER=groq

# vLLM endpoint (used when LLM_PROVIDER=vllm; COMPANY_LLM_* still honoured)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=

# llama.cpp llama-server endpoint (used when LLM_PROVIDER=llamacpp; no key needed)
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=qwen2.5-14b

# ---- STT provider selection: groq | parakeet | whisper ----
STT_PROVIDER=groq

# Groq Whisper (used when STT_PROVIDER=groq; auth via LLM_API_KEY)
STT_MODEL=whisper-large-v3-turbo

# NVIDIA Parakeet via NeMo (used when STT_PROVIDER=parakeet; pip install "nemo_toolkit[asr]")
# HuggingFace id (downloaded on first use) or a local .nemo file
PARAKEET_MODEL_PATH=nvidia/parakeet-tdt-0.6b-v2

# Local faster-whisper (used when STT_PROVIDER=whisper)
STT_MODEL_SIZE=large-v3-turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# ---- TTS provider selection: groq | piper | kokoro ----
TTS_PROVIDER=groq

# Groq Orpheus TTS (used when TTS_PROVIDER=groq; auth via LLM_API_KEY)
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=tara
TTS_FORMAT=wav

# Piper TTS (used when TTS_PROVIDER=piper; downloaded on first run if missing)
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx

# Kokoro TTS (used when TTS_PROVIDER=kokoro; requires `pip install kokoro`)
KOKORO_VOICE=af_heart

# ---- Web search (optional; search_web tool is disabled when unset) ----
# Tavily API key from https://app.tavily.com
TAVILY_API_KEY=your_tavily_key_here
